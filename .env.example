# Copy to .env and fill in. Never commit .env.

# Anthropic API — used by the Dashboard chat and the hourly scan.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# ClickUp personal API token + the list the Dashboard syncs from.
EXPO_PUBLIC_CLICKUP_API_TOKEN=
EXPO_PUBLIC_CLICKUP_LIST_ID=

# Google OAuth client IDs (create in Google Cloud Console).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Microsoft identity (Azure AD app registration).
EXPO_PUBLIC_MS_CLIENT_ID=
EXPO_PUBLIC_MS_TENANT_ID=common

# Dev overrides — leave empty in production.
# Default: on (mocks render the Dashboard before real APIs are wired).
# Set to 0 to hit real services.
EXPO_PUBLIC_USE_MOCKS=1
# Override hourly scan cadence in ms. Omit to use the 1-hour default.
EXPO_PUBLIC_SCAN_INTERVAL_MS=
# Optional override for the joke endpoint.
EXPO_PUBLIC_JOKES_API=
