# Copy to .env and fill in. Never commit .env.

# Anthropic API — powers Ottley. Required.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# ClickUp — user can also enter this at runtime on Profile
EXPO_PUBLIC_CLICKUP_API_TOKEN=
EXPO_PUBLIC_CLICKUP_LIST_ID=

# Google OAuth — create at console.cloud.google.com. Enable:
#  Gmail API, Calendar API, Drive API.
# Scopes requested: calendar, gmail.readonly, drive.readonly.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional platform-specific overrides:
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Microsoft OAuth — register at entra.microsoft.com.
# Scopes: Mail.Read, Chat.Read, offline_access.
EXPO_PUBLIC_MS_CLIENT_ID=
EXPO_PUBLIC_MS_TENANT_ID=common

# Market data
# Alpha Vantage — free tier key at alphavantage.co/support/#api-key
EXPO_PUBLIC_ALPHA_VANTAGE_KEY=

# Football-data.org — free tier, Champions League fixtures + scores.
EXPO_PUBLIC_FOOTBALL_DATA_KEY=

# Dev overrides
# Set to 0 to hit real APIs instead of mock dashboard data.
EXPO_PUBLIC_USE_MOCKS=1
# Hourly scan cadence in ms (omit for 1-hour default).
EXPO_PUBLIC_SCAN_INTERVAL_MS=
# Optional jokes endpoint override.
EXPO_PUBLIC_JOKES_API=
